POSTGRES_DB=mydatabase
POSTGRES_USER=myuser
POSTGRES_PASSWORD=change-me

RABBITMQ_DEFAULT_USER=myuser
RABBITMQ_DEFAULT_PASS=change-me

REDIS_PASSWORD=change-me

MINIO_ROOT_USER=myuser
MINIO_ROOT_PASSWORD=change-me

# Cloudflare Turnstile secret key (free — https://dash.cloudflare.com/?to=/:account/turnstile).
# Only required to run the app itself (./mvnw spring-boot:run); tests use a dummy value
# from src/test/resources/application-test.yaml.
TURNSTILE_SECRET_KEY=change-me

# OpenAI API key (https://platform.openai.com/api-keys, paid). Only required to run the
# app itself (./mvnw spring-boot:run); tests use a dummy value from
# src/test/resources/application-test.yaml.
OPENAI_API_KEY=change-me

# Enables OpenAPI/Swagger UI (/v3/api-docs, /swagger-ui/index.html). Still requires an
# authenticated session — see specify/features/api-documentation/SPEC.md. Off by default.
API_DOCS_ENABLED=false

# Email address for the one bootstrap staff user created by
# V13__create_bootstrap_staff_user.sql — this is how you get your very first login on a
# fresh deployment (via the normal login-code flow, no password). Only required to run the
# app itself (./mvnw spring-boot:run); tests use a dummy value from
# src/test/resources/application-test.yaml. See specify/features/staff-bootstrap-user/SPEC.md.
KNOWLY_BOOTSTRAP_STAFF_EMAIL=change-me@conectabyte.com

# Base64-encoded 32-byte keys used to encrypt/HMAC the CPF/RG fields at rest.
# Generate with: openssl rand -base64 32 (use a different value for each — do
# not reuse one key for both). Required to run the app itself
# (./mvnw spring-boot:run); tests use a dummy value from
# src/test/resources/application-test.yaml.
CPF_RG_ENCRYPTION_KEY=change-me
CPF_RG_HMAC_KEY=change-me
