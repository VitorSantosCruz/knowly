POSTGRES_DB=mydatabase
POSTGRES_USER=myuser
POSTGRES_PASSWORD=change-me

RABBITMQ_DEFAULT_USER=myuser
RABBITMQ_DEFAULT_PASS=change-me

REDIS_PASSWORD=change-me

# Cloudflare Turnstile secret key (free — https://dash.cloudflare.com/?to=/:account/turnstile).
# Only required to run the app itself (./mvnw spring-boot:run); tests use a dummy value
# from src/test/resources/application-test.yaml.
TURNSTILE_SECRET_KEY=change-me

# OpenAI API key (https://platform.openai.com/api-keys, paid). Only required to run the
# app itself (./mvnw spring-boot:run); tests use a dummy value from
# src/test/resources/application-test.yaml.
OPENAI_API_KEY=change-me

# Enables OpenAPI/Swagger UI (/v3/api-docs, /swagger-ui/index.html). Still requires an
# authenticated session — see specify/features/api-documentation/SPEC.md. Off by default.
API_DOCS_ENABLED=false
